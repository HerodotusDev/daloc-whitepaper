# Suppress warnings that conflict with this project's style.
#
#  1 - Command terminated with space.
#  8 - Wrong length of dash.
#  9 - `]' expected, found `)' — half-open intervals [a, b) are intentional.
# 12 - Interword spacing (`\ ') — false positive after \emph{}, \daloc{}, etc.
# 13 - Intersentence spacing (`\@') — abbreviations like USDC, CDP, NAV end sentences.
# 17 - Mismatched brackets — false positive from multi-file \input processing.
# 24 - Delete this space to maintain correct pagereferences.
# 36 - Vertical rules in tables.
# 38 - Punctuation in front of quotes — standard English style (period inside closing quotes).
# 44 - User Regex.
CmdLine {
  -n1
  -n8
  -n9
  -n12
  -n13
  -n17
  -n24
  -n36
  -n38
  -n44
}
